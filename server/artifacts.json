        {
          "label": "Provider-specific code stays in its adapter",
          "path": "reference/ingestion/src/capability_framework/adapters/provider_a.py",
          "symbol": "read",
          "notes": [
            "Only the status-code lookup is provider-specific; reading and mapping reuse the generic adapter.",
            "Adding a provider with a new quirk means one new adapter function, registered in adapters/__init__.py."
          ]
        },
        {
          "label": "One shared runner for every feed",
          "path": "reference/ingestion/src/capability_framework/runner.py",
          "symbol": "run_feed",
          "notes": [
            "The same function runs for every feed: adapter, validation, quarantine, MERGE, audit.",
            "The finally block writes the audit row whether the feed succeeds or fails.",
            "Errors are re-raised so the job's retry and alert settings apply."
          ]
        },
        {
          "label": "Rules compile from configuration to SQL",
          "path": "reference/ingestion/src/capability_framework/validation.py",
          "symbol": "quarantine_reasons_sql",
          "notes": [
            "Rules come from the use-case spec, not code.",
            "Each row gets an array of failed rule names, so quarantine records say why a row was rejected."
          ]
        }
      ]
    },
