{
  "version": "0.2.0",
  "configurations": [
    {
      // Python debugger with Databricks Connect switched on by "databricks": true. Python runs locally,
      // Spark work runs on the compute selected in the extension.
      "name": "Debug file with Databricks Connect",
      "type": "debugpy",
      "databricks": true,
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      // "purpose": ["debug-test"] makes the debug icon in the Testing panel use this configuration, so
      // tests that call Spark get Databricks Connect. The plain Run icon does not.
      "name": "Unit tests with Databricks Connect",
      "type": "debugpy",
      "databricks": true,
      "request": "launch",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
