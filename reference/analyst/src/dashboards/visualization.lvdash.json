{
  "datasets": [
    {
      "name": "ds_monthly",
      "displayName": "Revenue by month",
      "queryLines": [
        "SELECT month, orders, revenue ",
        "FROM v_revenue_by_month"
      ]
    },
    {
      "name": "ds_region_segment",
      "displayName": "Revenue by region and segment",
      "queryLines": [
        "SELECT region, segment, orders, revenue ",
        "FROM v_revenue_by_region_segment"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Revenue overview"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "sub",
            "multilineTextboxSpec": {
              "lines": [
                "Reads the same two governed views as the notebook charts."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "kpi-revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monthly",
                  "fields": [
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
                    },
                    {
                      "name": "monthly(month)",
                      "expression": "DATE_TRUNC(\"MONTH\", `month`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(revenue)",
                  "displayName": "Revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                },
                "period": {
                  "fieldName": "monthly(month)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-orders",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monthly",
                  "fields": [
                    {
                      "name": "sum(orders)",
                      "expression": "SUM(`orders`)"
                    },
                    {
                      "name": "monthly(month)",
                      "expression": "DATE_TRUNC(\"MONTH\", `month`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(orders)",
                  "displayName": "Orders",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact"
                  }
                },
                "period": {
                  "fieldName": "monthly(month)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Orders"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-regions",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_region_segment",
                  "fields": [
                    {
                      "name": "countdistinct(region)",
                      "expression": "COUNT(DISTINCT `region`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "countdistinct(region)",
                  "displayName": "Regions"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Regions"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "revenue-trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_monthly",
                  "fields": [
                    {
                      "name": "monthly(month)",
                      "expression": "DATE_TRUNC(\"MONTH\", `month`)"
                    },
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "monthly(month)",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Month"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue by month"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "revenue-region",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_region_segment",
                  "fields": [
                    {
                      "name": "region",
                      "expression": "`region`"
                    },
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
                    },
                    {
                      "name": "segment",
                      "expression": "`segment`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "region",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Region"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                },
                "color": {
                  "fieldName": "segment",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Segment"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue by region and segment"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 5,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "detail",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_region_segment",
                  "fields": [
                    {
                      "name": "region",
                      "expression": "`region`"
                    },
                    {
                      "name": "segment",
                      "expression": "`segment`"
                    },
                    {
                      "name": "orders",
                      "expression": "`orders`"
                    },
                    {
                      "name": "revenue",
                      "expression": "`revenue`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "region",
                    "displayName": "Region"
                  },
                  {
                    "fieldName": "segment",
                    "displayName": "Segment"
                  },
                  {
                    "fieldName": "orders",
                    "displayName": "Orders"
                  },
                  {
                    "fieldName": "revenue",
                    "displayName": "Revenue"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Region and segment detail"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 11,
            "width": 12,
            "height": 7
          }
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": {
        "light": "#FCFCFC",
        "dark": "#1F272D"
      },
      "widgetBackgroundColor": {
        "light": "#FFFFFF",
        "dark": "#11171C"
      },
      "fontColor": {
        "light": "#11171C",
        "dark": "#E8ECF0"
      },
      "selectionColor": {
        "light": "#2272B4",
        "dark": "#8ACAFF"
      },
      "visualizationColors": [
        "#0072B2",
        "#E69F00",
        "#009E73",
        "#CC79A7",
        "#D55E00"
      ],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}