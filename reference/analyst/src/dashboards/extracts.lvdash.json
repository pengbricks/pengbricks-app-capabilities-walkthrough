{
  "datasets": [
    {
      "name": "ds_extract",
      "displayName": "Partner extract",
      "queryLines": [
        "SELECT order_id, customer_id, segment, order_date, quantity, revenue ",
        "FROM extract_orders"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Extract",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Partner orders extract"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "sub",
            "multilineTextboxSpec": {
              "lines": [
                "Same filtered rows that the weekly Excel and pipe-delimited files contain."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "kpi-revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
                    },
                    {
                      "name": "monthly(order_date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `order_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(revenue)",
                  "displayName": "Revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                },
                "period": {
                  "fieldName": "monthly(order_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-orders",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "count(order_id)",
                      "expression": "COUNT(`order_id`)"
                    },
                    {
                      "name": "monthly(order_date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `order_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "count(order_id)",
                  "displayName": "Orders",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact"
                  }
                },
                "period": {
                  "fieldName": "monthly(order_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Orders"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-qty",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "sum(quantity)",
                      "expression": "SUM(`quantity`)"
                    },
                    {
                      "name": "monthly(order_date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `order_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(quantity)",
                  "displayName": "Units",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact"
                  }
                },
                "period": {
                  "fieldName": "monthly(order_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Units"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "revenue-trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "monthly(order_date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `order_date`)"
                    },
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "monthly(order_date)",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Month"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue by month"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 5,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "revenue-segment",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "segment",
                      "expression": "`segment`"
                    },
                    {
                      "name": "sum(revenue)",
                      "expression": "SUM(`revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "segment",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Segment"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Revenue (USD)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Revenue by segment"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 5,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "rows",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "order_id",
                      "expression": "`order_id`"
                    },
                    {
                      "name": "customer_id",
                      "expression": "`customer_id`"
                    },
                    {
                      "name": "segment",
                      "expression": "`segment`"
                    },
                    {
                      "name": "order_date",
                      "expression": "`order_date`"
                    },
                    {
                      "name": "quantity",
                      "expression": "`quantity`"
                    },
                    {
                      "name": "revenue",
                      "expression": "`revenue`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "order_id",
                    "displayName": "Order"
                  },
                  {
                    "fieldName": "customer_id",
                    "displayName": "Customer"
                  },
                  {
                    "fieldName": "segment",
                    "displayName": "Segment"
                  },
                  {
                    "fieldName": "order_date",
                    "displayName": "Date"
                  },
                  {
                    "fieldName": "quantity",
                    "displayName": "Quantity"
                  },
                  {
                    "fieldName": "revenue",
                    "displayName": "Revenue"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Extract rows"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 11,
            "width": 12,
            "height": 7
          }
        }
      ]
    },
    {
      "name": "filters",
      "displayName": "Filters",
      "pageType": "PAGE_TYPE_GLOBAL_FILTERS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "f-date",
            "queries": [
              {
                "name": "ds_extract_order_date",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "order_date",
                      "expression": "`order_date`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "order_date",
                    "displayName": "Order date",
                    "queryName": "ds_extract_order_date"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Order date"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "f-seg",
            "queries": [
              {
                "name": "ds_extract_segment",
                "query": {
                  "datasetName": "ds_extract",
                  "fields": [
                    {
                      "name": "segment",
                      "expression": "`segment`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "segment",
                    "displayName": "Segment",
                    "queryName": "ds_extract_segment"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Segment"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 0,
            "width": 4,
            "height": 2
          }
        }
      ]
    }
  ],
  "uiSettings": {
    "theme": {
      "canvasBackgroundColor": {
        "light": "#FCFCFC",
        "dark": "#1F272D"
      },
      "widgetBackgroundColor": {
        "light": "#FFFFFF",
        "dark": "#11171C"
      },
      "fontColor": {
        "light": "#11171C",
        "dark": "#E8ECF0"
      },
      "selectionColor": {
        "light": "#2272B4",
        "dark": "#8ACAFF"
      },
      "visualizationColors": [
        "#0072B2",
        "#E69F00",
        "#009E73",
        "#CC79A7",
        "#D55E00"
      ],
      "widgetHeaderAlignment": "LEFT"
    }
  }
}