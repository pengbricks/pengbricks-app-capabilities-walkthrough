{
  "datasets": [
    {
      "name": "ds_hourly",
      "displayName": "Statements per hour",
      "queryLines": [
        "SELECT date_trunc('HOUR', start_time) AS hour, warehouse_name, count(*) AS statements, ",
        "round(avg(waiting_at_capacity_duration_ms) / 1000, 2) AS avg_wait_at_capacity_s, ",
        "round(max(waiting_at_capacity_duration_ms) / 1000, 2) AS max_wait_at_capacity_s, ",
        "round(avg(total_duration_ms) / 1000, 2) AS avg_total_s ",
        "FROM capacity_query_history WHERE end_time IS NOT NULL GROUP BY ALL"
      ]
    },
    {
      "name": "ds_events",
      "displayName": "Warehouse events",
      "queryLines": [
        "SELECT event_time, warehouse_name, event_type, cluster_count FROM capacity_warehouse_events ORDER BY event_time DESC LIMIT 200"
      ]
    },
    {
      "name": "ds_settings",
      "displayName": "Warehouse settings",
      "queryLines": [
        "SELECT name, size, min_clusters, max_clusters, auto_stop_minutes, warehouse_type, serverless, state, role FROM warehouse_settings ORDER BY name"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Main",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
