                    {
                      "name": "daily(hour)",
                      "expression": "DATE_TRUNC(\"DAY\", `hour`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(statements)",
                  "displayName": "Statements",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
