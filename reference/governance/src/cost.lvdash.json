{
  "datasets": [
    {
      "name": "ds_usage",
      "displayName": "Daily spend",
      "queryLines": [
        "SELECT usage_date, product, coalesce(guide_job, '(untagged)') AS guide_job, usage_user, round(sum(cost_usd), 2) AS cost_usd ",
        "FROM cost_usage_enriched GROUP BY ALL"
      ]
    },
    {
      "name": "ds_forecast",
      "displayName": "Actual and forecast",
      "queryLines": [
        "SELECT ds, series, cost_usd FROM cost_actual_vs_forecast ORDER BY ds"
      ]
    },
    {
      "name": "ds_jobs",
      "displayName": "Costly jobs",
      "queryLines": [
        "SELECT job_name, runs, cost_usd_30d, usd_per_run FROM opt_costly_jobs ORDER BY usd_per_run DESC"
      ]
    },
    {
      "name": "ds_idle",
      "displayName": "Warehouse optimization",
      "queryLines": [
        "SELECT warehouse_name, cost_usd_30d, statements_30d, auto_stop_minutes, flags FROM opt_idle_warehouses ORDER BY cost_usd_30d DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Main",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Cost tracking and chargeback"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "subtitle",
            "multilineTextboxSpec": {
              "lines": [
                "List-price spend from system.billing.usage and system.billing.list_prices for this workspace."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "filter_day",
            "queries": [
              {
                "name": "ds_usage_usage_date",
                "query": {
                  "datasetName": "ds_usage",
                  "fields": [
                    {
                      "name": "usage_date",
                      "expression": "`usage_date`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "usage_date",
                    "displayName": "Usage date",
                    "queryName": "ds_usage_usage_date"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Usage date"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi-spend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_usage",
                  "fields": [
                    {
                      "name": "sum(cost_usd)",
                      "expression": "SUM(`cost_usd`)"
                    },
                    {
                      "name": "daily(usage_date)",
                      "expression": "DATE_TRUNC(\"DAY\", `usage_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(cost_usd)",
                  "displayName": "Spend in range (USD)",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                },
                "period": {
                  "fieldName": "daily(usage_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Spend in range (USD)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 4,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-forecast",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_forecast",
                  "fields": [
                    {
                      "name": "sum(cost_usd)",
                      "expression": "SUM(`cost_usd`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(cost_usd)",
                  "displayName": "Forecast",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Forecast spend, next 30 days (USD)"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 4,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "bar-daily",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_usage",
                  "fields": [
                    {
                      "name": "day(usage_date)",
                      "expression": "DATE_TRUNC(\"DAY\", `usage_date`)"
                    },
                    {
                      "name": "sum(cost_usd)",
                      "expression": "SUM(`cost_usd`)"
                    },
                    {
                      "name": "product",
                      "expression": "`product`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "day(usage_date)",
                  "scale": {
                    "type": "temporal"
                  },
                  "displayName": "Time"
                },
                "y": {
                  "fieldName": "sum(cost_usd)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "USD",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                },
                "color": {
                  "fieldName": "product",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Product"
                }
